# ============================================================
# voteapp environment variables
# Copy this file to .env.local and fill in your keys.
# ============================================================

# ─── Appwrite ────────────────────────────────────────────────
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
# Server API key used by route handlers (node-appwrite). Never exposed to the browser.
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_DATABASE_ID=voteapp

# Table ids are fixed slugs in appwrite.config.json (users, organizations, memberships, ...)
# and need no env vars. Push the schema with: appwrite push tables
# Buckets are added here as they land (docs/DATA_MODEL.md).

# ─── Session ─────────────────────────────────────────────────
# Signing key for the voteapp_session cookie. MUST NOT be the Appwrite API key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Platform ────────────────────────────────────────────────
# Timestamps are stored in UTC; this is the display zone (CLAUDE.md conventions).
PLATFORM_TZ=Africa/Accra
# Platform-wide kill switch for morale candidates (PRD 5.4a, decision #29).
# On by default; set exactly "false" to disable the feature platform-wide.
# MORALE_CANDIDATES_ENABLED=true
# Same for free votes (decision #29).
# FREE_VOTES_ENABLED=true

# ─── Sentry (optional; inert when the DSN is empty) ─────────
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN is a host-side variable for source-map upload, never in the repo.

# ─── Payments (USSD_AND_PAYMENTS.md) ─────────────────────────
# "paystack" (decided 2026-11-12), "hubtel" (adapter kept, not in use) or
# "mock" for development; mock refuses to run in production.
PAYMENT_PROVIDER=mock

# ─── Paystack (PAYMENT_PROVIDER=paystack) ────────────────────
# Secret key from Settings → API Keys & Webhooks (sk_test_… or sk_live_…).
# Server only. Also signs webhooks. Webhook URL to set in the dashboard:
# NEXT_PUBLIC_APP_URL + /api/payments/callback/paystack
PAYSTACK_SECRET_KEY=
# Paystack requires a customer email; voters give none, so charges use
# <paymentId>@<this domain>. A domain you own; defaults to the app's host.
PAYSTACK_CUSTOMER_EMAIL_DOMAIN=
# Optional comma-separated allowlist of Paystack webhook IPs (see Paystack's
# webhook docs); the signature is always checked.
# PAYSTACK_CALLBACK_IPS=
# PAYSTACK_TIMEOUT_MS=15000

# ─── Hubtel payments (PAYMENT_PROVIDER=hubtel; not in use) ───
# Merchant API credentials from the Hubtel dashboard. Never in the browser.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# Merchant account number (POS sales id).
HUBTEL_MERCHANT_ACCOUNT=
# "nested" (ResponseCode + Data{...}, the classic Receive Money API) or "flat".
# Confirm against the sandbox: docs/SMOKE_TEST.md.
HUBTEL_PAYLOAD_SHAPE=nested
# Endpoints, templated on {merchant}. Override if your account uses other hosts.
# HUBTEL_RECEIVE_URL=https://rmp.hubtel.com/merchantaccount/merchants/{merchant}/receive/mobilemoney
# HUBTEL_STATUS_URL=https://api-txnstatus.hubtel.com/transactions/{merchant}/status
# Public callback URL; defaults to NEXT_PUBLIC_APP_URL + /api/payments/callback/hubtel
# HUBTEL_CALLBACK_URL=
# Optional comma-separated allowlist of Hubtel callback source IPs.
# HUBTEL_CALLBACK_IPS=
# HUBTEL_TIMEOUT_MS=10000
# Signs the mock provider's callbacks (dev only). Any random string.
MOCK_PAYMENT_SECRET=
# Shown to the browser so the vote page can offer the dev confirmation panel.
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
# Platform commission in basis points. Defaults to 1000 (10%, decision #2);
# set only to override platform-wide. Per-organization overrides live in the
# organizations table.
# PLATFORM_COMMISSION_BPS=1000
# Rate limits are counted in the rate_limits table, shared by every instance.
# "memory" counts per instance only (no database calls); for local experiments.
# RATE_LIMIT_STORE=appwrite
# Protects /api/internal/payments/reconcile (rule 5) when called by hand. Any random string.
INTERNAL_JOB_SECRET=
# Set by Vercel for cron jobs (vercel.json); the route accepts it as a bearer token.
# CRON_SECRET=

# ─── Nominee portal ──────────────────────────────────────────
# Public base URL for claim links in invite emails (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "resend" (decided 2026-11-12, #32) or "log" (prints emails to the server
# log, never counts as sent; the default in development). Unset in production
# sends nothing, and invites return the link for the organizer to share.
EMAIL_PROVIDER=log
# Resend API key (re_…), server only. Sending domain verified in Resend.
RESEND_API_KEY=
# From address on the verified domain, e.g. voteapp <noreply@mail.example.com>
EMAIL_FROM=
# Optional reply-to address for buyers and nominees who answer an email.
# EMAIL_REPLY_TO=

# ─── USSD (Hubtel shortcode → POST /api/ussd/hubtel) ─────────
# Shared secret Hubtel sends as the Basic-auth password or an x-ussd-secret
# header. In production, this or USSD_CALLBACK_IPS must be set.
# USSD_WEBHOOK_SECRET=
# Optional comma-separated allowlist of Hubtel USSD source IPs.
# USSD_CALLBACK_IPS=

# ─── Flyer engine ────────────────────────────────────────────
# The USSD shortcode Hubtel assigns, e.g. *713*42#. Printed on flyers as
# "Dial *713*42#, enter <code>". A placeholder is shown until set.
USSD_SHORTCODE=

# ─── Tickets ─────────────────────────────────────────────────
# Signs ticket QR tokens and buyers' payment access keys. 32+ random bytes;
# rotating it invalidates unscanned tickets and any open ticket confirmation page.
TICKET_SECRET=

# ─── Payouts ─────────────────────────────────────────────────
# The most one vote payment may charge, in pesewas (decision #16). Default 200000 = GHS 2,000.
# VOTE_PAYMENT_MAX_PESEWAS=200000

# Minimum payout in pesewas (e.g. 5000 = GHS 50), per deployment (decision #3).
# Unset means no minimum. Payouts are approved and marked paid by a super admin
# (users.isSuperAdmin, set in the Appwrite console for the first one).
# PAYOUT_MIN_PESEWAS=

# ─── Privacy policy (/privacy, decision #28) ─────────────────
# Where people send data requests (access, correction, deletion under Act 843).
# Shown on the privacy page; the contact line is hidden while unset, so set it
# before launch.
PRIVACY_CONTACT_EMAIL=
